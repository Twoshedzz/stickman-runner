// Settings for Vercel's server functions. The app's own settings (Expo's) keep import/export
// lines as they are, which Node can't load. Vercel uses the tsconfig.json nearest to each
// function, so this one makes them plain CommonJS.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/__tests__/**"]
}
