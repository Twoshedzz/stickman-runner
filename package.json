{
  "name": "stickman-runner",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "CI=false expo start",
    "start:tunnel": "CI=false expo start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "postinstall": "(patch-package || echo \"patch-package failed: see docs/WEB_PATCHES_AND_ARCHITECTURE.md\") && (node node_modules/@shopify/react-native-skia/scripts/setup-canvaskit.js || true)",
    "test": "jest",
    "difficulty": "DIFFICULTY_REPORT=1 jest difficulty.report"
  },
  "dependencies": {
    "@expo-google-fonts/audiowide": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.9",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "patch-package": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ]
  }
}
