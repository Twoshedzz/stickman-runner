{
  "name": "stickman-runner",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "CI=false expo start",
    "start:tunnel": "CI=false expo start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "postinstall": "(patch-package 2>/dev/null || (patch -p1 -N -i patches/expo+55.0.32.patch 2>/dev/null; patch -p1 -N -i patches/canvaskit-wasm+0.40.0.patch 2>/dev/null; true)) && (node scripts/patch-canvaskit-worker.js 2>/dev/null; true) && (node node_modules/@shopify/react-native-skia/scripts/setup-canvaskit.js || true)",
    "test": "jest",
    "difficulty": "DIFFICULTY_REPORT=1 jest difficulty.report"
  },
  "dependencies": {
    "@expo-google-fonts/audiowide": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "2.4.18",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "patch-package": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ]
  }
}
